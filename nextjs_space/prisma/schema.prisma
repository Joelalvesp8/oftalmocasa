// Schema do Sistema Oftalmocasa
// Multi-tenant administrative system with RBAC

generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/sistema_oftalmocasa/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ============================================
// NextAuth.js Tables
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Sistema Oftalmocasa Tables
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Hashed password for credentials login
  image         String?
  role          String    @default("Agente Administrativo")
  sector        String?   // Setor do usuário
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts    Account[]
  sessions    Session[]
  permissions Permission[]
  doctor      Doctor?   // Relação com cadastro médico (se for médico)

  @@index([email])
  @@index([role])
  @@index([sector])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  level       Int      @unique // Hierarquia: quanto menor, mais poder (1 = Diretoria)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
}

model Sector {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id        String   @id @default(cuid())
  userId    String
  toolName  String   // Nome da ferramenta (ex: "Controle Financeiro", "Relatórios")
  canAccess Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolName])
  @@index([userId])
  @@index([toolName])
}

// ============================================
// Sistema de Repasse Médico
// ============================================

model Doctor {
  id                String            @id @default(cuid())
  
  // Dados Pessoais
  name              String
  birthDate         DateTime?
  graduationDate    DateTime?
  councilType       String            // CRM, CRO, etc
  councilNumber     String
  councilState      String?
  cpf               String            @unique
  phone             String
  email             String            @unique
  
  // Dados Empresariais
  companyName       String?           // Razão Social
  cnpj              String?           @unique
  taxRegime         TaxRegime?        // LP, SN
  
  // Dados Bancários
  bankNumber        String?           // Coluna Nº
  bankName          String?           // BANCO
  bankAgency        String?           // AG
  bankAccount       String?           // C/C
  pixKeyType        String?           // TIPO CHAVE
  pixKey            String?           // CHAVE PIX
  
  // Classificação (INTERNO - não visível para o médico)
  paymentType       PaymentType       @default(VARIABLE) // FIXO/VAR
  paymentClass      PaymentClass      @default(CLASS_1)
  monthlyFixedValue Float?            // Para médicos com pagamento fixo
  
  // Status de Aprovação
  status            DoctorStatus      @default(PENDING)
  approvedAt        DateTime?
  approvedBy        String?           // ID do admin que aprovou
  rejectedReason    String?
  
  // Relacionado a User (quando médico cria conta)
  userId            String?           @unique
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Relacionamentos
  schedules         DoctorSchedule[]
  appointments      Appointment[]
  productions       Production[]
  paymentReports    PaymentReport[]
  documents         DoctorDocument[]
  
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([cpf])
  @@index([email])
  @@index([isActive])
  @@index([status])
  @@index([userId])
}

model DoctorSchedule {
  id              String         @id @default(cuid())
  doctorId        String
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  scheduleCode    String         // Ex: "GERAL", "ESPECIALISTA", "MAPA"
  scheduleName    String         // Nome da agenda
  sector          DoctorSector   // AMBULATORIO, EMERGENCIA, etc
  
  // Configurações da agenda
  patientsPerHour Int            // 4 para geral, 3 para especialista, 6 para mapa
  hourlyRate      Float          // Valor por hora desta agenda
  exceedBonus     Float          @default(40) // Bonus por paciente excedente
  
  // Dias e horários
  weekDays        Json           // [1,2,3,4,5] = seg a sex
  startTime       String         // "08:00"
  endTime         String         // "12:00"
  
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@unique([doctorId, scheduleCode])
  @@index([doctorId])
  @@index([isActive])
}

model Production {
  id              String         @id @default(cuid())
  doctorId        String
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  date            DateTime
  scheduleCode    String         // Tipo de agenda
  scheduleName    String
  
  // Dados da produção
  scheduledHours  Float          // Horas agendadas
  workedHours     Float          // Horas trabalhadas
  
  scheduledPatients Int          // Pacientes agendados
  attendedPatients  Int          // Pacientes atendidos
  exceededPatients  Int          // Pacientes excedentes
  
  // Cálculos
  hourlyRate      Float          // Taxa horária
  baseValue       Float          // Valor base (horas x taxa)
  exceedValue     Float          // Valor excedente
  totalValue      Float          // Total
  
  status          ProductionStatus @default(PENDING)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  paymentReport   PaymentReport? @relation(fields: [paymentReportId], references: [id])
  paymentReportId String?
  
  @@unique([doctorId, date, scheduleCode])
  @@index([doctorId, date])
  @@index([status])
}

model PaymentReport {
  id              String         @id @default(cuid())
  
  month           Int            // 1-12
  year            Int            // 2025
  
  doctorId        String
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  // Dados do pagamento
  taxRegime       String         // LP/SN
  bankNumber      String?        // Nº
  bankName        String?        // BANCO
  bankAgency      String?        // AG
  bankAccount     String?        // C/C
  pixKeyType      String?        // TIPO CHAVE
  pixKey          String?        // CHAVE PIX
  paymentType     String         // FIXO/VAR
  
  // Valores
  totalHours      Float
  totalPatients   Int
  exceededPatients Int
  
  baseValue       Float          // VALOR_BRUTO base
  exceedValue     Float          // Valor excedente
  grossValue      Float          // VALOR_BRUTO total
  
  // Status
  status          ReportStatus   @default(DRAFT)
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  
  // Produções relacionadas
  productions     Production[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@unique([doctorId, month, year])
  @@index([month, year])
  @@index([status])
}

model Appointment {
  id              String         @id @default(cuid())
  
  doctorId        String
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  scheduleCode    String
  date            DateTime
  time            String         // "08:00"
  
  // Paciente
  patientName     String
  patientPhone    String?
  patientEmail    String?
  healthPlan      String?        // Plano de saúde
  
  status          AppointmentStatus @default(SCHEDULED)
  
  // Controle
  arrivedAt       DateTime?
  attendedAt      DateTime?
  completedAt     DateTime?
  
  notes           String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([doctorId, date])
  @@index([status])
  @@index([date])
}

model DoctorDocument {
  id                String         @id @default(cuid())
  doctorId          String
  doctor            Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  // Informações do documento
  name              String         // Nome do arquivo
  description       String?        // Descrição do documento
  type              String         // Tipo: "RG", "CPF", "DIPLOMA", "CRM", "CONTRATO", "OUTROS"
  
  // Armazenamento em S3
  cloudStoragePath  String         // Caminho no S3
  isPublic          Boolean        @default(false) // Documentos médicos são privados
  fileSize          Int?           // Tamanho do arquivo em bytes
  mimeType          String?        // Tipo MIME do arquivo
  
  // Controle
  uploadedBy        String?        // ID do usuário que fez upload (null se foi o próprio médico)
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@index([doctorId])
  @@index([type])
}

// ============================================
// Enums
// ============================================

enum PaymentType {
  FIXED     // Pagamento fixo
  VARIABLE  // Pagamento variável por hora
}

enum PaymentClass {
  CLASS_1   // R$ 125/h
  CLASS_2   // R$ 160/h
  CLASS_3   // R$ 200/h
  CLASS_4   // R$ 500 fixo
  CLASS_5   // R$ 125/h (apenas MAPA)
}

enum TaxRegime {
  LP  // Lucro Presumido
  SN  // Simples Nacional
  LR  // Lucro Real
}

enum DoctorSector {
  AMBULATORIO
  EMERGENCIA
  CENTRO_CIRURGICO
}

enum ProductionStatus {
  PENDING
  REVIEWED
  APPROVED
  PAID
}

enum ReportStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  PAID
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DoctorStatus {
  PENDING           // Aguardando aprovação
  APPROVED          // Aprovado
  REJECTED          // Rejeitado
  INCOMPLETE        // Documentação incompleta
}

// ============================================
// Sistema de Notas Fiscais
// ============================================

model Invoice {
  id                String            @id @default(cuid())

  // Identificação da Nota
  number            String            // Número da nota
  series            String?           // Série da nota
  accessKey         String?           @unique // Chave de acesso (44 dígitos)
  invoiceType       InvoiceType       // PRODUTO ou SERVICO

  // Fornecedor/Prestador
  supplierCnpj      String
  supplierName      String
  supplierIe        String?           // Inscrição Estadual
  supplierAddress   String?

  // Datas
  emissionDate      DateTime
  entryDate         DateTime          @default(now()) // Data de entrada no sistema
  competenceDate    DateTime          // Data de competência (normalmente = emissionDate)

  // Valores
  subtotal          Float             // Valor dos produtos/serviços
  discountValue     Float             @default(0)
  taxValue          Float             @default(0) // ICMS, ISS, etc
  freightValue      Float             @default(0)
  insuranceValue    Float             @default(0)
  otherExpenses     Float             @default(0)
  totalValue        Float             // Valor total da nota

  // Status e Controle
  status            InvoiceStatus     @default(PENDING)

  // Armazenamento do XML
  xmlPath           String?           // Caminho no S3
  xmlFileName       String?
  pdfPath           String?           // PDF da DANFE

  // Observações
  notes             String?

  // Relacionamentos
  items             InvoiceItem[]
  payments          InvoicePayment[]

  // Usuário que fez o upload
  uploadedBy        String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([supplierCnpj])
  @@index([invoiceType])
  @@index([status])
  @@index([emissionDate])
  @@index([competenceDate])
  @@index([entryDate])
}

model InvoiceItem {
  id                String            @id @default(cuid())
  invoiceId         String
  invoice           Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Informações do item
  code              String?           // Código do produto/serviço
  description       String
  ncm               String?           // NCM (Nomenclatura Comum do Mercosul)
  cfop              String?           // Código Fiscal de Operações
  unit              String?           // Unidade (UN, KG, etc)

  // Quantidades e Valores
  quantity          Float
  unitValue         Float
  totalValue        Float
  discountValue     Float             @default(0)

  // Impostos
  icmsValue         Float             @default(0)
  ipiValue          Float             @default(0)
  pisValue          Float             @default(0)
  cofinsValue       Float             @default(0)
  issValue          Float             @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([invoiceId])
}

model InvoicePayment {
  id                String            @id @default(cuid())
  invoiceId         String
  invoice           Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Forma de Pagamento
  paymentMethod     PaymentMethod     // A_VISTA, FATURADO, CARTAO, etc
  installmentNumber Int               @default(1) // Número da parcela
  totalInstallments Int               @default(1) // Total de parcelas

  // Valores
  amount            Float             // Valor desta parcela/pagamento

  // Datas
  dueDate           DateTime?         // Data de vencimento (para faturado)
  paymentDate       DateTime?         // Data efetiva do pagamento (CAIXA)
  competenceDate    DateTime          // Data de competência

  // Status
  status            PaymentStatus     @default(PENDING)

  // Informações bancárias (se aplicável)
  bankAccount       String?
  checkNumber       String?
  transactionId     String?

  // Observações
  notes             String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([status])
  @@index([dueDate])
  @@index([paymentDate])
  @@index([competenceDate])
}

// ============================================
// Enums para Notas Fiscais
// ============================================

enum InvoiceType {
  PRODUTO   // NF-e (Nota Fiscal Eletrônica de Produto)
  SERVICO   // NFS-e (Nota Fiscal de Serviço Eletrônica)
}

enum InvoiceStatus {
  PENDING           // Aguardando processamento
  PROCESSED         // Processada
  APPROVED          // Aprovada
  REJECTED          // Rejeitada
  CANCELLED         // Cancelada
}

enum PaymentMethod {
  A_VISTA           // À vista
  FATURADO          // Faturado (a prazo)
  CARTAO_CREDITO    // Cartão de crédito
  CARTAO_DEBITO     // Cartão de débito
  BOLETO            // Boleto bancário
  PIX               // PIX
  TRANSFERENCIA     // Transferência bancária
  CHEQUE            // Cheque
  OUTROS            // Outros
}

enum PaymentStatus {
  PENDING           // Pendente de pagamento
  PAID              // Pago
  OVERDUE           // Vencido
  CANCELLED         // Cancelado
  PARTIAL           // Parcialmente pago
}
